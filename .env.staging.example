SPRING_PROFILES_ACTIVE=staging

DB_HOST=your-staging-host
DB_PORT=5432
DB_NAME=eoffice
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

TZ=UTC
JAVA_TOOL_OPTIONS=-Duser.timezone=UTC
SPRING_JACKSON_TIME_ZONE=UTC
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_TIME_ZONE=UTC

# JWT signing secret (HS256, must be at least 32 characters)
JWT_SECRET=

# Cookie path must cover context-path: /api/v1 + /auth
# (BE staging runs with context-path /api/v1, so the RT cookie needs Path=/api/v1/auth)
COOKIE_PATH=/api/v1/auth

# Browser origins allowed to call BE cross-origin (comma-separated, e.g. https://fe.example.com)
# Empty = CORS blocked for all cross-origin calls; FE via Vite proxy / nginx (same-origin) does not need this
JWT_ALLOWED_ORIGINS=

# SMTP mail config
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-mail-username
MAIL_PASSWORD=your-mail-password
MAIL_FROM=no-reply@eoffice.local
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Password reset link config
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
